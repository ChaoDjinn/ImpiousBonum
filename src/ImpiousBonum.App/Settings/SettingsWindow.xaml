<Window x:Class="ImpiousBonum.App.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Impious Bonum"
        ThemeMode="System"
        Width="1600" Height="940" MinWidth="900" MinHeight="560"
        WindowStartupLocation="Manual">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="NavColumn" Width="256" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <DockPanel Margin="6,8,6,8">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                <Button x:Name="CollapseButton" Click="OnCollapse" Width="40" Height="34" Padding="0" Background="Transparent" BorderThickness="0"
                        ToolTip="Hide the page names" AutomationProperties.Name="Hide the page names">
                    <TextBlock Style="{DynamicResource Glyph}" Text="&#xE700;" />
                </Button>
                <Image x:Name="Logo" Width="16" Height="16" Margin="10,0,10,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock x:Name="AppName" Text="Impious Bonum" FontSize="12" VerticalAlignment="Center" />
            </StackPanel>
            <ListBox x:Name="Nav" BorderThickness="0" Background="Transparent" Padding="0" SelectionChanged="OnNavChanged"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Pages" />
        </DockPanel>

        <!-- The page, on a layer of its own as in Windows' Settings. -->
        <Border Grid.Column="1" Background="{DynamicResource LayerFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1,1,0,0" CornerRadius="8,0,0,0">
            <ContentControl x:Name="PageHost" Focusable="False" />
        </Border>
    </Grid>
</Window>
