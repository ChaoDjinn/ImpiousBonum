<UserControl x:Class="ImpiousBonum.App.Settings.GalleryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="40,28,40,24">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Style="{DynamicResource PageTitle}" Text="Gallery" />
            <TextBlock Style="{DynamicResource PageIntro}" Margin="0,0,0,16"
                       Text="Ready-made layouts to start from. Pick the screen you want one for to see those that suit its shape. The previews show your own readings." />
            <DockPanel Margin="0,0,0,14">
                <Button DockPanel.Dock="Right" Click="OnRefresh" ToolTip="Fetch the gallery again">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{DynamicResource ButtonGlyph}" Text="&#xE72C;" />
                        <TextBlock Text="Refresh" />
                    </StackPanel>
                </Button>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="For" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <ComboBox x:Name="ScreenBox" Width="320" SelectionChanged="OnFilterChanged" AutomationProperties.Name="For"
                              ToolTip="The screen you want a layout for: only layouts its shape suits are shown, closest in size first" />
                    <TextBlock Text="Showing" VerticalAlignment="Center" Margin="20,0,10,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <ComboBox x:Name="DetailBox" Width="230" SelectionChanged="OnFilterChanged" AutomationProperties.Name="Showing"
                              ToolTip="How much a layout shows at once. A big screen across the room suits a few large widgets as much as a small one does." />
                </StackPanel>
            </DockPanel>
        </StackPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ListBox x:Name="EntryList" SelectionChanged="OnSelected" HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Layouts">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,6">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Details}" Style="{DynamicResource NoteText}" />
                            <TextBlock Text="{Binding Description}" Style="{DynamicResource SecondaryText}" FontSize="12" Margin="0,4,0,0" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <DockPanel Grid.Column="1" Margin="16,0,0,0">
                <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                    <Button x:Name="UseButton" DockPanel.Dock="Right" IsEnabled="False" Click="OnUse" Style="{DynamicResource AccentButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{DynamicResource ButtonGlyph}" Text="&#xE896;" />
                            <TextBlock x:Name="UseText" Text="Add to my layouts" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="EditButton" DockPanel.Dock="Right" Margin="0,0,8,0" Visibility="Collapsed" Click="OnEdit">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{DynamicResource ButtonGlyph}" Text="&#xE70F;" />
                            <TextBlock Text="Edit it" />
                        </StackPanel>
                    </Button>
                    <TextBlock x:Name="StatusText" VerticalAlignment="Center" Style="{DynamicResource NoteText}" Margin="0,0,12,0"
                               Text="Pictures and fonts in a layout show once it's added." />
                </DockPanel>
                <Border Style="{DynamicResource Card}" Padding="12">
                    <Grid>
                        <Viewbox x:Name="PreviewBox" Stretch="Uniform" />
                        <TextBlock x:Name="PreviewText" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                                   Style="{DynamicResource SecondaryText}" Margin="24" />
                    </Grid>
                </Border>
            </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>
