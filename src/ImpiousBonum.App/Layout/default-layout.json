// Impious Bonum layout. Save this file and the dashboard updates immediately.
//
// width/height are design units; the whole canvas scales uniformly to fit the window.
// Text templates use {metric.id} or {metric.id:spec}. Spec tokens: a number format (0.0, N0),
// a byte unit (KB, MB, GB, TB) or "nounit". Missing readings show as "—".
//
// Metric ids: cpu.load, cpu.threads, cpu.clock, cpu.core.0.load (each logical processor),
// mem.used, mem.total, mem.available, mem.load, mem.commit.used, mem.commit.total, mem.commit.load,
// gpu.name, gpu.load, gpu.load.3d, gpu.load.decode, gpu.load.encode, gpu.load.compute,
// gpu.vram.used, gpu.vram.total, gpu.vram.free, gpu.vram.usedPct, gpu.shared.used,
// disk.C.free, disk.C.used, disk.C.total, disk.C.usedPct, disk.C.label, disk.C.read, disk.C.write, disk.C.active
// (any drive letter), disk.read, disk.write,
// net.down, net.up, net.down.total, net.up.total, net.ip, net.adapter, net.ping,
// sys.uptime, sys.name, sys.battery, sys.battery.status (laptops)
// media.title, media.artist, media.album, media.app, media.status, media.position, media.duration, media.progress (what's playing)
// weather.temp, weather.feels, weather.high, weather.low, weather.condition, weather.humidity, weather.wind, weather.rain, ... (tray → Weather)
// custom.<source>.<field> from your own web addresses and commands (tray → Custom data…)
// With the sensor service: cpu.temp, cpu.power, gpu.temp, gpu.hotspot, gpu.power, gpu.fan, fps, sensors.status,
// fps.frametime, fps.frametime.max (slowest frame in the last second), fps.low1, fps.low01 (1% and 0.1% lows),
// plus every raw sensor as hw/... (run "sensors\ImpiousBonum.Sensors.exe list" to see them).
{
  "width": 1920,
  "height": 480,
  "theme": {
    "fontFamily": "Segoe UI",
    "fontWeight": "Light",
    // "fontFile": "C:\\path\\to\\SomeFont-Light.otf",
    "foreground": "#FFFFFF",
    "secondary": "#D0FFFFFF",
    "accent": "#FF9800",
    "background": "#000000",
    // "backgroundImage": "C:\\path\\to\\wallpaper.jpg", "backgroundFit": "fill", "backgroundOpacity": 0.5,
    "track": "#1A1A1A"
  },
  "widgets": [
    // Four columns on a 40-unit margin. Loads over the last two minutes on the left.
    { "type": "graph", "x": 40, "y": 24, "width": 440, "height": 128,
      "label": "CPU", "text": "{cpu.load}", "metric": "cpu.load", "style": "line" },
    { "type": "graph", "x": 40, "y": 176, "width": 440, "height": 128,
      "label": "GPU", "text": "{gpu.load} · {gpu.vram.used:GB}", "metric": "gpu.load", "style": "line" },
    { "type": "graph", "x": 40, "y": 328, "width": 440, "height": 128,
      "label": "Memory", "text": "{mem.used} / {mem.total}", "metric": "mem.used", "style": "area" },

    // Temperatures and frame rate, in line with the graphs. They need the sensor service (tray → Sensors).
    { "type": "icon", "x": 540, "y": 24, "width": 360, "height": 128, "icon": "cpu", "text": "{cpu.temp:0 nounit} °C",
      "fontSize": 60, "iconSize": 56, "gap": 36 },
    { "type": "icon", "x": 540, "y": 176, "width": 360, "height": 128, "icon": "gpu", "text": "{gpu.temp:0 nounit} °C",
      "fontSize": 60, "iconSize": 56, "gap": 36 },
    { "type": "icon", "x": 540, "y": 328, "width": 360, "height": 128, "icon": "fps", "text": "{fps:0 nounit} FPS",
      "fontSize": 60, "iconSize": 56, "gap": 36 },

    { "type": "clock", "x": 960, "y": 24, "width": 420, "height": 432, "timeSize": 150, "dateSize": 29 },

    { "type": "drives", "x": 1440, "y": 24, "width": 440, "height": 280, "fontSize": 25, "barHeight": 5 },
    { "type": "rows", "x": 1440, "y": 328, "width": 440, "height": 128, "fontSize": 26, "valueFontSize": 26, "align": "bottom",
      "rows": [
        { "label": "Download", "text": "{net.down}" },
        { "label": "Upload", "text": "{net.up}" },
        { "label": "Ping", "text": "{net.ping}" }
      ] }
  ]
}
