<Window x:Class="ImpiousBonum.App.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:ImpiousBonum.App"
        Title="Impious Bonum"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        WindowStartupLocation="Manual"
        Background="Black"
        UseLayoutRounding="True">
    <Grid>
        <Viewbox x:Name="Scaler" Stretch="Uniform">
            <!-- The edit overlay is added on top of the view while the layout editor is open. -->
            <Grid x:Name="Stage">
                <app:DashboardView x:Name="View" />
            </Grid>
        </Viewbox>
        <!-- Dims the dashboard (schedule, away). Catches taps only when the screen is too dark to see what they'd press. -->
        <Rectangle x:Name="DimOverlay" Fill="Black" Opacity="0" IsHitTestVisible="False" />
        <!-- Alerts that flash: a pulsing outline and a banner, above the dimming so they show on a dark screen. Tap the banner to dismiss. -->
        <Rectangle x:Name="AlertOutline" Visibility="Collapsed" IsHitTestVisible="False" Stroke="#FFE53935" StrokeThickness="6" />
        <Border x:Name="AlertBanner" Visibility="Collapsed" VerticalAlignment="Top" Background="#F0B71C1C" Padding="16,6" Cursor="Hand">
            <TextBlock x:Name="AlertText" Foreground="White" FontFamily="Segoe UI" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
        </Border>
        <!-- Which page is showing, for a moment after moving between pages. -->
        <StackPanel x:Name="PageDots" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                    Margin="0,0,0,10" Opacity="0" IsHitTestVisible="False" />
        <!-- Shown while the windowed dashboard is unlocked, so it's clear it can be dragged and resized. -->
        <Rectangle x:Name="MoveOutline" Visibility="Collapsed" IsHitTestVisible="False"
                   Stroke="#B0FFFFFF" StrokeThickness="2" StrokeDashArray="4 3" />
    </Grid>
</Window>
