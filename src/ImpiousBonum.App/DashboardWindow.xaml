<Window x:Class="ImpiousBonum.App.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:ImpiousBonum.App"
        Title="Impious Bonum"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        WindowStartupLocation="Manual"
        Background="Black"
        UseLayoutRounding="True">
    <Viewbox x:Name="Scaler" Stretch="Uniform">
        <!-- The edit overlay is added on top of the view while the layout editor is open. -->
        <Grid x:Name="Stage">
            <app:DashboardView x:Name="View" />
        </Grid>
    </Viewbox>
</Window>
