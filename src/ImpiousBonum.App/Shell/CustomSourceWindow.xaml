<Window x:Class="ImpiousBonum.App.Shell.CustomSourceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:ImpiousBonum.App.Controls"
        ThemeMode="System"
        Title="Custom data source"
        Width="620" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Style="{DynamicResource DialogFooter}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="OkButton" Content="Save" IsDefault="True" Click="OnOk" MinWidth="{DynamicResource DialogButtonWidth}"
                        Style="{DynamicResource AccentButtonStyle}" />
                <Button Content="Cancel" IsCancel="True" Margin="{DynamicResource ButtonGap}" MinWidth="{DynamicResource DialogButtonWidth}" />
            </StackPanel>
        </Border>
        <StackPanel Margin="{DynamicResource DialogPadding}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Text="Name" VerticalAlignment="Center" />
                <TextBox x:Name="NameBox" Grid.Column="1" TextChanged="OnChanged" c:Placeholder.Text="e.g. home, for custom.home.temp" />

                <RadioButton x:Name="WebChoice" Grid.Row="1" Content="Web address" GroupName="Kind" IsChecked="True" VerticalAlignment="Center" Margin="0,10,0,0" Checked="OnChanged" />
                <TextBox x:Name="UrlBox" Grid.Row="1" Grid.Column="1" Margin="0,10,0,0" TextChanged="OnChanged" c:Placeholder.Text="https://…" />

                <TextBlock Text="Headers" Grid.Row="2" Margin="28,8,0,0" Style="{DynamicResource SecondaryText}" />
                <TextBox x:Name="HeadersBox" Grid.Row="2" Grid.Column="1" Margin="0,8,0,0" Height="56" AcceptsReturn="True" TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto" FontFamily="Cascadia Mono, Consolas" TextChanged="OnChanged"
                         ToolTip="One per line, e.g. Authorization: Bearer your-token" />

                <RadioButton x:Name="CommandChoice" Grid.Row="3" Content="Command" GroupName="Kind" VerticalAlignment="Center" Margin="0,14,0,0" Checked="OnChanged" />
                <TextBox x:Name="CommandBox" Grid.Row="3" Grid.Column="1" Margin="0,14,0,0" TextChanged="OnChanged"
                         c:Placeholder.Text="e.g. powershell or C:\Tools\status.exe"
                         ToolTip="A program, e.g. powershell or C:\Tools\status.exe" />

                <TextBlock Text="Arguments" Grid.Row="4" Margin="28,8,0,0" VerticalAlignment="Center" Style="{DynamicResource SecondaryText}" />
                <TextBox x:Name="ArgumentsBox" Grid.Row="4" Grid.Column="1" Margin="0,8,0,0" TextChanged="OnChanged"
                         ToolTip="e.g. -NoProfile -File C:\Scripts\status.ps1" />

                <TextBlock Text="Every" Grid.Row="5" Margin="0,14,0,0" VerticalAlignment="Center" />
                <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Margin="0,14,0,0">
                    <TextBox x:Name="EveryBox" Width="70" Text="60" TextChanged="OnChanged" />
                    <TextBlock Text="seconds" VerticalAlignment="Center" Margin="8,0,0,0" />
                </StackPanel>

                <TextBlock Text="Fields" Grid.Row="6" Margin="0,14,0,0" />
                <StackPanel Grid.Row="6" Grid.Column="1" Margin="0,14,0,0">
                    <TextBox x:Name="FieldsBox" Height="90" AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto"
                             FontFamily="Cascadia Mono, Consolas" TextChanged="OnChanged" />
                    <TextBlock Style="{DynamicResource NoteText}" Margin="0,6,0,0"
                               Text="One per line: name = path : unit. The path finds a value in JSON, e.g. main.temp or items[0].value; leave fields empty to use the whole output as value. Units: auto, text, number, percent, celsius, fahrenheit, bytes, bytespersecond, milliseconds, watts, volts, megahertz, rpm, fps." />
                </StackPanel>
            </Grid>

            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                <Button x:Name="TestButton" MinWidth="{DynamicResource DialogButtonWidth}" Click="OnTest">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{DynamicResource ButtonGlyph}" Text="&#xE768;" />
                        <TextBlock Text="Test" />
                    </StackPanel>
                </Button>
                <TextBlock x:Name="TestStatus" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap" />
            </StackPanel>
            <TextBox x:Name="TestResults" Margin="0,8,0,0" Height="90" IsReadOnly="True" FontFamily="Cascadia Mono, Consolas"
                     VerticalScrollBarVisibility="Auto" Visibility="Collapsed" />

            <TextBlock x:Name="ProblemText" Style="{DynamicResource ProblemText}" c:Dialog.ShowAfterInput="True" Margin="0,12,0,0" />
        </StackPanel>
    </DockPanel>
</Window>
