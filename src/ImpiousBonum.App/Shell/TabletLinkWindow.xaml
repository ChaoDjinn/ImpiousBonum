<Window x:Class="ImpiousBonum.App.Shell.TabletLinkWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tablet view"
        ThemeMode="System"
        Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <StackPanel Margin="16">
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12">
            Scan the code, or open the link, on a tablet or phone on the same Wi-Fi.
            Tip: add it to the home screen to show the dashboard without the browser's bars, and set the tablet's screen timeout to never.
        </TextBlock>

        <Border Background="White" Padding="12" HorizontalAlignment="Center" CornerRadius="6">
            <Image x:Name="QrImage" Width="240" Height="240" RenderOptions.BitmapScalingMode="NearestNeighbor" />
        </Border>

        <ComboBox x:Name="AddressBox" Margin="0,12,0,0" SelectionChanged="OnAddressChanged"
                  ToolTip="This PC's addresses. The first is usually the home network." />
        <TextBox x:Name="LinkBox" Margin="0,8,0,0" IsReadOnly="True" FontFamily="Cascadia Mono, Consolas" />
        <TextBlock x:Name="NoNetworkText" Margin="0,8,0,0" TextWrapping="Wrap" Visibility="Collapsed"
                   Text="This PC doesn't seem to be on a local network, so there's no link to show." />

        <TextBlock TextWrapping="Wrap" Margin="0,12,0,0" Opacity="0.8">
            Anyone with the link on your network can see the dashboard (nothing else, and they can't change anything).
            New link stops old links working. If Windows asks about the firewall, allow private networks only.
        </TextBlock>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="CopyButton" Content="Copy link" Click="OnCopy" MinWidth="90"
                    Style="{DynamicResource AccentButtonStyle}" />
            <Button Content="New link" Click="OnNewLink" Margin="8,0,0,0" MinWidth="90" />
            <Button Content="Close" IsCancel="True" Click="OnClose" Margin="8,0,0,0" MinWidth="80" />
        </StackPanel>
    </StackPanel>
</Window>
