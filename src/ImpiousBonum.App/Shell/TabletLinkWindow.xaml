<Window x:Class="ImpiousBonum.App.Shell.TabletLinkWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tablet view"
        ThemeMode="System"
        Width="480" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Style="{DynamicResource DialogFooter}">
            <Grid>
                <Button HorizontalAlignment="Left" Click="OnNewLink" ToolTip="Stops the old link working">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{DynamicResource ButtonGlyph}" Text="&#xE72C;" />
                        <TextBlock Text="New link" />
                    </StackPanel>
                </Button>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CopyButton" Click="OnCopy" MinWidth="{DynamicResource DialogButtonWidth}" Style="{DynamicResource AccentButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{DynamicResource ButtonGlyph}" Text="&#xE8C8;" />
                            <TextBlock Text="Copy link" />
                        </StackPanel>
                    </Button>
                    <Button Content="Close" IsCancel="True" Click="OnClose" Margin="{DynamicResource ButtonGap}" MinWidth="{DynamicResource DialogButtonWidth}" />
                </StackPanel>
            </Grid>
        </Border>
        <StackPanel Margin="{DynamicResource DialogPadding}">
            <TextBlock x:Name="IntroText" TextWrapping="Wrap" Margin="0,0,0,16"
                       Text="Scan the code, or open the link, on a tablet or phone on the same Wi-Fi." />

            <Border Background="White" Padding="12" HorizontalAlignment="Center" CornerRadius="8">
                <Image x:Name="QrImage" Width="240" Height="240" RenderOptions.BitmapScalingMode="NearestNeighbor" />
            </Border>

            <ComboBox x:Name="AddressBox" Margin="0,16,0,0" SelectionChanged="OnAddressChanged"
                      ToolTip="This PC's addresses. The first is usually the home network." />
            <TextBox x:Name="LinkBox" Margin="0,8,0,0" IsReadOnly="True" FontFamily="Cascadia Mono, Consolas" />
            <TextBlock x:Name="NoNetworkText" Margin="0,8,0,0" TextWrapping="Wrap" Visibility="Collapsed"
                       Style="{DynamicResource ProblemText}"
                       Text="This PC doesn't seem to be on a local network, so there's no link to show." />

            <TextBlock Style="{DynamicResource NoteText}" Margin="0,14,0,0"
                       Text="Tip: add it to the home screen to show the dashboard without the browser's bars, and set the tablet's screen timeout to never." />
            <TextBlock Style="{DynamicResource NoteText}" Margin="0,6,0,0"
                       Text="Anyone with the link on your network can see the dashboard (nothing else, and they can't change anything). New link stops old links working. If Windows asks about the firewall, allow private networks only." />
        </StackPanel>
    </DockPanel>
</Window>
