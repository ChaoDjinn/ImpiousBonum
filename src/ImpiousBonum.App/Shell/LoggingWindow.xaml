<Window x:Class="ImpiousBonum.App.Shell.LoggingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:ImpiousBonum.App.Controls"
        ThemeMode="System"
        Title="Logging"
        Width="500" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Style="{DynamicResource DialogFooter}">
            <Grid>
                <Button HorizontalAlignment="Left" Click="OnOpenFolder">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{DynamicResource ButtonGlyph}" Text="&#xE838;" />
                        <TextBlock Text="Open logs folder" />
                    </StackPanel>
                </Button>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="OkButton" Content="Save" IsDefault="True" Click="OnOk" MinWidth="{DynamicResource DialogButtonWidth}" Style="{DynamicResource AccentButtonStyle}" />
                    <Button Content="Cancel" IsCancel="True" Margin="{DynamicResource ButtonGap}" MinWidth="{DynamicResource DialogButtonWidth}" />
                </StackPanel>
            </Grid>
        </Border>
        <StackPanel Margin="{DynamicResource DialogPadding}">
            <CheckBox x:Name="EnabledCheck" Content="Log readings to CSV files" Checked="OnChanged" Unchecked="OnChanged" />
            <TextBlock Style="{DynamicResource NoteText}" Margin="28,2,0,14"
                       Text="One file a day in the logs folder. Each row is one period: every metric's average, lowest and highest over it, read once a second." />

            <TextBlock Text="Metrics" Style="{DynamicResource SectionHeading}" />
            <ListBox x:Name="MetricList" Height="150" SelectionChanged="OnChanged" c:Placeholder.Text="No metrics yet. Add the ones to log." />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button x:Name="AddButton" MinWidth="{DynamicResource DialogButtonWidth}" Click="OnAdd">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{DynamicResource ButtonGlyph}" Text="&#xE710;" />
                        <TextBlock Text="Add…" />
                    </StackPanel>
                </Button>
                <Button x:Name="RemoveButton" Content="Remove" MinWidth="{DynamicResource DialogButtonWidth}" Margin="{DynamicResource ButtonGap}" Click="OnRemove" />
            </StackPanel>

            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="A row every" VerticalAlignment="Center" />
                <ComboBox x:Name="EveryBox" Grid.Column="1" SelectionChanged="OnChanged" />
                <TextBlock Text="Keep logs for" Grid.Row="1" VerticalAlignment="Center" Margin="0,8,0,0" />
                <ComboBox x:Name="KeepBox" Grid.Row="1" Grid.Column="1" Margin="0,8,0,0" SelectionChanged="OnChanged" />
            </Grid>

            <TextBlock x:Name="ProblemText" Style="{DynamicResource ProblemText}" c:Dialog.ShowAfterInput="True" Margin="0,12,0,0" />
        </StackPanel>
    </DockPanel>
</Window>
