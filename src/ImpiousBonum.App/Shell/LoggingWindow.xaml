<Window x:Class="ImpiousBonum.App.Shell.LoggingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        ThemeMode="System"
        Title="Logging"
        Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False">
    <StackPanel Margin="16">
        <CheckBox x:Name="EnabledCheck" Content="Log readings to CSV files" Checked="OnChanged" Unchecked="OnChanged" />
        <TextBlock TextWrapping="Wrap" FontSize="11.5" Opacity="0.75" Margin="0,4,0,10"
                   Text="One file a day in the logs folder. Each row is one period: every metric's average, lowest and highest over it, read once a second." />

        <TextBlock Text="Metrics" FontWeight="SemiBold" Margin="0,0,0,6" />
        <ListBox x:Name="MetricList" Height="150" SelectionChanged="OnChanged" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
            <Button x:Name="AddButton" Content="Add…" MinWidth="80" Click="OnAdd" />
            <Button x:Name="RemoveButton" Content="Remove" MinWidth="80" Margin="8,0,0,0" Click="OnRemove" />
        </StackPanel>

        <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="A row every" VerticalAlignment="Center" />
            <ComboBox x:Name="EveryBox" Grid.Column="1" SelectionChanged="OnChanged" />
            <TextBlock Text="Keep logs for" Grid.Row="1" VerticalAlignment="Center" Margin="0,8,0,0" />
            <ComboBox x:Name="KeepBox" Grid.Row="1" Grid.Column="1" Margin="0,8,0,0" SelectionChanged="OnChanged" />
        </Grid>

        <TextBlock x:Name="ProblemText" Foreground="IndianRed" TextWrapping="Wrap" Margin="0,10,0,0" MinHeight="18" />
        <Grid Margin="0,12,0,0">
            <Button Content="Open logs folder" HorizontalAlignment="Left" MinWidth="80" Click="OnOpenFolder" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="OkButton" Content="Save" IsDefault="True" Click="OnOk" MinWidth="80" Style="{DynamicResource AccentButtonStyle}" />
                <Button Content="Cancel" IsCancel="True" Margin="8,0,0,0" MinWidth="80" />
            </StackPanel>
        </Grid>
    </StackPanel>
</Window>
