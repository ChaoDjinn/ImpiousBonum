<Window x:Class="ImpiousBonum.App.Shell.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:ImpiousBonum.App.Controls"
        ThemeMode="System"
        Title="About Impious Bonum"
        Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Style="{DynamicResource DialogFooter}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CopyButton" Click="OnCopy" MinWidth="{DynamicResource DialogButtonWidth}"
                        ToolTip="Copy the version and system details, for a problem report">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{DynamicResource ButtonGlyph}" Text="&#xE8C8;" />
                        <TextBlock x:Name="CopyText" Text="Copy details" />
                    </StackPanel>
                </Button>
                <!-- Shown with Show(), not as a dialog, so Close needs to close it itself. -->
                <Button Content="Close" IsCancel="True" IsDefault="True" c:Dialog.ClosesWindow="True" Margin="{DynamicResource ButtonGap}"
                        MinWidth="{DynamicResource DialogButtonWidth}" Style="{DynamicResource AccentButtonStyle}" />
            </StackPanel>
        </Border>
        <StackPanel Margin="24,24,24,20">
            <StackPanel Orientation="Horizontal">
                <Image x:Name="Logo" Width="64" Height="64" VerticalAlignment="Top" RenderOptions.BitmapScalingMode="HighQuality" />
                <StackPanel Margin="16,2,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Impious Bonum" FontSize="24" FontWeight="SemiBold" />
                    <TextBlock x:Name="VersionText" Margin="0,2,0,0" Style="{DynamicResource SecondaryText}" />
                </StackPanel>
            </StackPanel>

            <TextBlock TextWrapping="Wrap" Margin="0,18,0,0"
                       Text="A lightweight system dashboard for a spare screen: your PC's readings, the time, the weather and what's playing, laid out how you like." />
            <TextBlock Margin="0,8,0,0" FontStyle="Italic" Style="{DynamicResource SecondaryText}"
                       Text="Dog-Latin for &quot;wicked good&quot;." />

            <WrapPanel Margin="0,16,0,0">
                <TextBlock Margin="0,0,16,4"><Hyperlink x:Name="GuideLink" Click="OnLink">User guide</Hyperlink></TextBlock>
                <TextBlock Margin="0,0,16,4"><Hyperlink x:Name="ChangelogLink" Click="OnLink">What's new</Hyperlink></TextBlock>
                <TextBlock Margin="0,0,16,4"><Hyperlink x:Name="RepositoryLink" Click="OnLink">GitHub</Hyperlink></TextBlock>
                <TextBlock Margin="0,0,16,4"><Hyperlink x:Name="IssueLink" Click="OnLink">Report a problem</Hyperlink></TextBlock>
            </WrapPanel>

            <TextBlock x:Name="DetailsText" Margin="0,14,0,0" Style="{DynamicResource NoteText}" />
            <TextBlock Margin="0,4,0,0" Style="{DynamicResource NoteText}">
                Free and open source under the <Hyperlink x:Name="LicenseLink" Click="OnLink">MIT licence</Hyperlink>.
            </TextBlock>
        </StackPanel>
    </DockPanel>
</Window>
