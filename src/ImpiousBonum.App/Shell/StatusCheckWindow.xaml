<Window x:Class="ImpiousBonum.App.Shell.StatusCheckWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:ImpiousBonum.App.Controls"
        ThemeMode="System"
        Title="Status check"
        Width="580" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Style="{DynamicResource DialogFooter}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="OkButton" Content="Save" IsDefault="True" Click="OnOk" MinWidth="{DynamicResource DialogButtonWidth}"
                        Style="{DynamicResource AccentButtonStyle}" />
                <Button Content="Cancel" IsCancel="True" Margin="{DynamicResource ButtonGap}" MinWidth="{DynamicResource DialogButtonWidth}" />
            </StackPanel>
        </Border>
        <StackPanel Margin="{DynamicResource DialogPadding}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Text="Name" VerticalAlignment="Center" />
                <TextBox x:Name="NameBox" Grid.Column="1" TextChanged="OnChanged" c:Placeholder.Text="e.g. NAS, for status.nas.up" />

                <TextBlock Text="Address" Grid.Row="1" Margin="0,10,0,0" VerticalAlignment="Top" Padding="0,6,0,0" />
                <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,10,0,0">
                    <TextBox x:Name="AddressBox" TextChanged="OnChanged" c:Placeholder.Text="e.g. nas.local, 192.168.1.10 or http://pi.hole/admin" />
                    <TextBlock Style="{DynamicResource NoteText}" Margin="0,6,0,0"
                               Text="A host name or IP address is pinged. A web address is asked for its page, which counts as up when it loads." />
                </StackPanel>

                <TextBlock Text="Page must say" Grid.Row="2" Margin="28,10,0,0" VerticalAlignment="Center" Style="{DynamicResource SecondaryText}" />
                <TextBox x:Name="ExpectBox" Grid.Row="2" Grid.Column="1" Margin="0,10,0,0" TextChanged="OnChanged"
                         c:Placeholder.Text="Optional: a word on the page when it's working"
                         ToolTip="Up only when the page has this in it, in any case: a word that's there only when the service is working." />

                <CheckBox x:Name="AnyCertificateCheck" Grid.Row="3" Grid.Column="1" Margin="0,8,0,0" Click="OnChanged"
                          Content="Accept its own certificate"
                          ToolTip="For an https address whose certificate Windows doesn't trust, as home servers often have their own." />

                <TextBlock Text="Every" Grid.Row="4" Margin="0,14,0,0" VerticalAlignment="Center" />
                <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="0,14,0,0">
                    <TextBox x:Name="EveryBox" Width="70" Text="60" TextChanged="OnChanged" />
                    <TextBlock Text="seconds" VerticalAlignment="Center" Margin="8,0,0,0" />
                </StackPanel>
            </Grid>

            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                <Button x:Name="TestButton" MinWidth="{DynamicResource DialogButtonWidth}" Click="OnTest">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{DynamicResource ButtonGlyph}" Text="&#xE768;" />
                        <TextBlock Text="Check now" />
                    </StackPanel>
                </Button>
                <TextBlock x:Name="TestStatus" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap" MaxWidth="380" />
            </StackPanel>

            <TextBlock x:Name="ProblemText" Style="{DynamicResource ProblemText}" c:Dialog.ShowAfterInput="True" Margin="0,12,0,0" />
        </StackPanel>
    </DockPanel>
</Window>
