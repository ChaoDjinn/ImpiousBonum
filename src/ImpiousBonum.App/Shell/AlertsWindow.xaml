<Window x:Class="ImpiousBonum.App.Shell.AlertsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:ImpiousBonum.App.Controls"
        ThemeMode="System"
        Title="Alerts"
        Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Style="{DynamicResource DialogFooter}">
            <!-- Shown with Show(), not as a dialog, so Close needs to close it itself. -->
            <Button Content="Close" IsCancel="True" c:Dialog.ClosesWindow="True" HorizontalAlignment="Right"
                    MinWidth="{DynamicResource DialogButtonWidth}" />
        </Border>
        <StackPanel Margin="{DynamicResource DialogPadding}">
            <TextBlock TextWrapping="Wrap"
                       Text="Be told when a reading stays out of bounds, such as the GPU hot spot above 95 °C for 10 seconds: a Windows notification, a banner flashing on the dashboard, or both." />
            <TextBlock Style="{DynamicResource NoteText}" Margin="0,6,0,0"
                       Text="Each alert goes off once, then again only after the reading has been back to normal for 30 seconds." />
            <ListBox x:Name="Rules" Height="170" Margin="0,14,0,0" SelectionChanged="OnSelectionChanged" MouseDoubleClick="OnEdit"
                     c:Placeholder.Text="No alerts yet. Add one to be told when a reading is out of bounds." />
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button MinWidth="{DynamicResource DialogButtonWidth}" Click="OnAdd">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{DynamicResource ButtonGlyph}" Text="&#xE710;" />
                        <TextBlock Text="Add…" />
                    </StackPanel>
                </Button>
                <Button x:Name="EditButton" Content="Edit…" MinWidth="{DynamicResource DialogButtonWidth}" Margin="{DynamicResource ButtonGap}" Click="OnEdit" />
                <Button x:Name="RemoveButton" Content="Remove" MinWidth="{DynamicResource DialogButtonWidth}" Margin="{DynamicResource ButtonGap}" Click="OnRemove" />
            </StackPanel>
        </StackPanel>
    </DockPanel>
</Window>
