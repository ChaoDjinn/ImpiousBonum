<Window x:Class="ImpiousBonum.App.Shell.GalleryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        ThemeMode="System"
        Title="Layout gallery"
        Width="1000" Height="600" MinWidth="700" MinHeight="420"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ListBox x:Name="EntryList" SelectionChanged="OnSelected" HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="0,4">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Details}" FontSize="11.5" Opacity="0.7" />
                        <TextBlock Text="{Binding Description}" TextWrapping="Wrap" FontSize="12" Margin="0,2,0,0" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Border Grid.Column="1" Margin="12,0,0,0" BorderBrush="#40808080" BorderThickness="1" Background="#10808080">
            <Grid>
                <Viewbox x:Name="PreviewBox" Stretch="Uniform" Margin="8" />
                <TextBlock x:Name="PreviewText" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"
                           TextAlignment="Center" Margin="24" Opacity="0.75" />
            </Grid>
        </Border>

        <TextBlock x:Name="StatusText" Grid.Row="1" Grid.ColumnSpan="2" VerticalAlignment="Center" TextWrapping="Wrap"
                   Margin="0,12,280,0" FontSize="12" Opacity="0.8"
                   Text="Layouts shared by other people. The preview shows your own readings; pictures and fonts in a layout show once it's imported." />
        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Refresh" MinWidth="80" Click="OnRefresh" />
            <Button x:Name="ImportButton" Content="Import" MinWidth="80" Margin="8,0,0,0" IsEnabled="False" Click="OnImport"
                    Style="{DynamicResource AccentButtonStyle}" />
            <Button Content="Close" IsCancel="True" MinWidth="80" Margin="8,0,0,0" />
        </StackPanel>
    </Grid>
</Window>
