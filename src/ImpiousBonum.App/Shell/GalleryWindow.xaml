<Window x:Class="ImpiousBonum.App.Shell.GalleryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        ThemeMode="System"
        Title="Layout gallery"
        Width="1040" Height="640" MinWidth="720" MinHeight="440"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Style="{DynamicResource DialogFooter}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="16,0,0,0">
                    <Button MinWidth="{DynamicResource DialogButtonWidth}" Click="OnRefresh">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{DynamicResource ButtonGlyph}" Text="&#xE72C;" />
                            <TextBlock Text="Refresh" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="ImportButton" MinWidth="{DynamicResource DialogButtonWidth}" Margin="{DynamicResource ButtonGap}" IsEnabled="False" Click="OnImport"
                            Style="{DynamicResource AccentButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{DynamicResource ButtonGlyph}" Text="&#xE896;" />
                            <TextBlock Text="Import" />
                        </StackPanel>
                    </Button>
                    <Button Content="Close" IsCancel="True" MinWidth="{DynamicResource DialogButtonWidth}" Margin="{DynamicResource ButtonGap}" />
                </StackPanel>
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" Style="{DynamicResource NoteText}"
                           Text="Layouts shared by other people. The preview shows your own readings; pictures and fonts in a layout show once it's imported." />
            </DockPanel>
        </Border>
        <Grid Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ListBox x:Name="EntryList" SelectionChanged="OnSelected" HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,6">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Details}" Style="{DynamicResource NoteText}" />
                            <TextBlock Text="{Binding Description}" Style="{DynamicResource SecondaryText}" FontSize="12" Margin="0,4,0,0" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Border Grid.Column="1" Margin="12,0,0,0" Style="{DynamicResource Card}" Padding="12">
                <Grid>
                    <Viewbox x:Name="PreviewBox" Stretch="Uniform" />
                    <TextBlock x:Name="PreviewText" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                               Style="{DynamicResource SecondaryText}" Margin="24" />
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</Window>
