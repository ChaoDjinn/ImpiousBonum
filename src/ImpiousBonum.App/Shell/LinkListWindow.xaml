<Window x:Class="ImpiousBonum.App.Shell.LinkListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        ThemeMode="System"
        Title="Links"
        Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False">
    <StackPanel Margin="16">
        <TextBlock x:Name="IntroText" TextWrapping="Wrap" Margin="0,0,0,10" />
        <ListBox x:Name="LinkList" Height="120" SelectionChanged="OnChanged" DisplayMemberPath="Name" />
        <Button x:Name="RemoveButton" Content="Remove" HorizontalAlignment="Right" Margin="0,6,0,0" MinWidth="80" Click="OnRemove" />

        <TextBlock x:Name="AddHeading" FontWeight="SemiBold" Margin="0,12,0,6" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="60" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="Name" VerticalAlignment="Center" />
            <TextBox x:Name="NameBox" Grid.Column="1" TextChanged="OnChanged" />
            <TextBlock Text="Link" Grid.Row="1" VerticalAlignment="Center" Margin="0,8,0,0" />
            <TextBox x:Name="LinkBox" Grid.Row="1" Grid.Column="1" Margin="0,8,0,0" TextChanged="OnChanged" />
        </Grid>
        <Button x:Name="AddButton" Content="Add" HorizontalAlignment="Right" Margin="0,8,0,0" MinWidth="80" Click="OnAdd" />

        <TextBlock x:Name="ProblemText" Foreground="IndianRed" TextWrapping="Wrap" Margin="0,6,0,0" MinHeight="18" />
        <TextBlock x:Name="NoteText" TextWrapping="Wrap" FontSize="11.5" Opacity="0.75" Margin="0,4,0,0" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Save" IsDefault="True" Click="OnOk" MinWidth="80" Style="{DynamicResource AccentButtonStyle}" />
            <Button Content="Cancel" IsCancel="True" Margin="8,0,0,0" MinWidth="80" />
        </StackPanel>
    </StackPanel>
</Window>
