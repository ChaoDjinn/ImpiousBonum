<Window x:Class="ImpiousBonum.App.Shell.LinkListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:ImpiousBonum.App.Controls"
        ThemeMode="System"
        Title="Links"
        Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Style="{DynamicResource DialogFooter}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Save" IsDefault="True" Click="OnOk" MinWidth="{DynamicResource DialogButtonWidth}" Style="{DynamicResource AccentButtonStyle}" />
                <Button Content="Cancel" IsCancel="True" Margin="{DynamicResource ButtonGap}" MinWidth="{DynamicResource DialogButtonWidth}" />
            </StackPanel>
        </Border>
        <StackPanel Margin="{DynamicResource DialogPadding}">
            <TextBlock x:Name="IntroText" TextWrapping="Wrap" Margin="0,0,0,12" />
            <ListBox x:Name="LinkList" Height="130" SelectionChanged="OnChanged" DisplayMemberPath="Name" />
            <Button x:Name="RemoveButton" Content="Remove" HorizontalAlignment="Right" Margin="0,8,0,0" MinWidth="{DynamicResource DialogButtonWidth}" Click="OnRemove" />

            <Border Style="{DynamicResource Card}" Margin="0,8,0,0" Padding="14,12">
                <StackPanel>
                    <TextBlock x:Name="AddHeading" Style="{DynamicResource SectionHeading}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Name" VerticalAlignment="Center" />
                        <TextBox x:Name="NameBox" Grid.Column="1" TextChanged="OnChanged" c:Placeholder.Text="Optional: the site's name is used" />
                        <TextBlock Text="Link" Grid.Row="1" VerticalAlignment="Center" Margin="0,8,0,0" />
                        <TextBox x:Name="LinkBox" Grid.Row="1" Grid.Column="1" Margin="0,8,0,0" TextChanged="OnChanged" c:Placeholder.Text="https://…" />
                    </Grid>
                    <DockPanel Margin="0,10,0,0">
                        <Button x:Name="AddButton" DockPanel.Dock="Right" MinWidth="{DynamicResource DialogButtonWidth}" Click="OnAdd">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{DynamicResource ButtonGlyph}" Text="&#xE710;" />
                                <TextBlock Text="Add" />
                            </StackPanel>
                        </Button>
                        <TextBlock x:Name="ProblemText" Style="{DynamicResource ProblemText}" VerticalAlignment="Center" Margin="0,0,12,0" />
                    </DockPanel>
                </StackPanel>
            </Border>

            <TextBlock x:Name="NoteText" Style="{DynamicResource NoteText}" Margin="0,14,0,0" />
        </StackPanel>
    </DockPanel>
</Window>
