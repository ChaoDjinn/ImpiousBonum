<Window x:Class="ImpiousBonum.App.Shell.CustomDataWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:ImpiousBonum.App.Controls"
        ThemeMode="System"
        Title="Custom data"
        Width="580" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Style="{DynamicResource DialogFooter}">
            <!-- Shown with Show(), not as a dialog, so Close needs to close it itself. -->
            <Button Content="Close" IsCancel="True" c:Dialog.ClosesWindow="True" HorizontalAlignment="Right"
                    MinWidth="{DynamicResource DialogButtonWidth}" />
        </Border>
        <StackPanel Margin="{DynamicResource DialogPadding}">
            <TextBlock TextWrapping="Wrap"
                       Text="Your own metrics from web addresses (JSON or text) and commands: Home Assistant sensors, a server's status, a script's output. Each field becomes a metric called custom.source.field that any widget can show." />
            <ListBox x:Name="Sources" Height="180" Margin="0,14,0,0" SelectionChanged="OnSelectionChanged" MouseDoubleClick="OnEdit"
                     c:Placeholder.Text="No sources yet. Add a web address or a command to read." />
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button MinWidth="{DynamicResource DialogButtonWidth}" Click="OnAdd">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{DynamicResource ButtonGlyph}" Text="&#xE710;" />
                        <TextBlock Text="Add…" />
                    </StackPanel>
                </Button>
                <Button x:Name="EditButton" Content="Edit…" MinWidth="{DynamicResource DialogButtonWidth}" Margin="{DynamicResource ButtonGap}" Click="OnEdit" />
                <Button x:Name="RemoveButton" Content="Remove" MinWidth="{DynamicResource DialogButtonWidth}" Margin="{DynamicResource ButtonGap}" Click="OnRemove" />
            </StackPanel>
            <TextBlock Style="{DynamicResource NoteText}" Margin="0,14,0,0"
                       Text="Sources are kept in settings.json on this PC, never in a layout, so a layout from someone else can't add one. Headers such as access tokens are stored there as plain text." />
        </StackPanel>
    </DockPanel>
</Window>
