<Window x:Class="ImpiousBonum.App.Shell.CustomDataWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        ThemeMode="System"
        Title="Custom data"
        Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <StackPanel Margin="16">
        <TextBlock TextWrapping="Wrap"
                   Text="Your own metrics from web addresses (JSON or text) and commands: Home Assistant sensors, a server's status, a script's output. Each field becomes a metric called custom.source.field that any widget can show." />
        <ListBox x:Name="Sources" Height="180" Margin="0,12,0,0" SelectionChanged="OnSelectionChanged" MouseDoubleClick="OnEdit" />
        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <Button Content="Add…" MinWidth="80" Click="OnAdd" />
            <Button x:Name="EditButton" Content="Edit…" MinWidth="80" Margin="8,0,0,0" Click="OnEdit" />
            <Button x:Name="RemoveButton" Content="Remove" MinWidth="80" Margin="8,0,0,0" Click="OnRemove" />
        </StackPanel>
        <TextBlock TextWrapping="Wrap" FontSize="11.5" Opacity="0.75" Margin="0,12,0,0"
                   Text="Sources are kept in settings.json on this PC, never in a layout, so a layout from someone else can't add one. Headers such as access tokens are stored there as plain text." />
        <Button Content="Close" IsCancel="True" HorizontalAlignment="Right" MinWidth="80" Margin="0,12,0,0" />
    </StackPanel>
</Window>
