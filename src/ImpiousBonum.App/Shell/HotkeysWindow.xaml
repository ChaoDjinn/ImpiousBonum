<Window x:Class="ImpiousBonum.App.Shell.HotkeysWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        ThemeMode="System"
        Title="Hotkeys"
        Width="500" SizeToContent="Height" MaxHeight="720" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Style="{DynamicResource DialogFooter}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="OkButton" Content="Save" IsDefault="True" Click="OnOk" MinWidth="{DynamicResource DialogButtonWidth}"
                        Style="{DynamicResource AccentButtonStyle}" />
                <Button Content="Cancel" IsCancel="True" Margin="{DynamicResource ButtonGap}" MinWidth="{DynamicResource DialogButtonWidth}" />
            </StackPanel>
        </Border>
        <DockPanel Margin="{DynamicResource DialogPadding}">
            <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,12"
                       Text="Click a box and press the keys, e.g. Ctrl+Alt+D. They work from anywhere, even in a game. Backspace clears one." />
            <TextBlock x:Name="ProblemText" DockPanel.Dock="Bottom" Style="{DynamicResource ProblemText}" Margin="0,10,0,0" />
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid x:Name="Rows">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="170" />
                    </Grid.ColumnDefinitions>
                </Grid>
            </ScrollViewer>
        </DockPanel>
    </DockPanel>
</Window>
