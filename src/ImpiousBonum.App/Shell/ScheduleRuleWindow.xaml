<Window x:Class="ImpiousBonum.App.Shell.ScheduleRuleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        ThemeMode="System"
        Title="Add to the schedule"
        Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False">
    <StackPanel Margin="16">
        <TextBlock Text="When" FontWeight="SemiBold" Margin="0,0,0,6" />
        <StackPanel Orientation="Horizontal">
            <RadioButton x:Name="Between" Content="Between" GroupName="When" IsChecked="True" VerticalAlignment="Center" Checked="OnChanged" />
            <TextBox x:Name="FromBox" Text="22:00" Width="70" Margin="8,0,0,0" TextChanged="OnChanged" />
            <TextBlock Text="and" VerticalAlignment="Center" Margin="8,0,8,0" />
            <TextBox x:Name="ToBox" Text="07:00" Width="70" TextChanged="OnChanged" />
        </StackPanel>
        <RadioButton x:Name="Dark" Content="While Windows is in dark mode" GroupName="When" Margin="0,8,0,0" Checked="OnChanged" />
        <RadioButton x:Name="Light" Content="While Windows is in light mode" GroupName="When" Margin="0,4,0,0" Checked="OnChanged" />

        <TextBlock Text="Show" FontWeight="SemiBold" Margin="0,16,0,6" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="70" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="Layout" VerticalAlignment="Center" />
            <ComboBox x:Name="LayoutBox" Grid.Column="1" SelectionChanged="OnChanged" />
            <TextBlock Text="Theme" Grid.Row="1" VerticalAlignment="Center" Margin="0,8,0,0" />
            <ComboBox x:Name="ThemeBox" Grid.Row="1" Grid.Column="1" Margin="0,8,0,0" SelectionChanged="OnChanged" />
        </Grid>

        <TextBlock x:Name="ProblemText" Foreground="IndianRed" TextWrapping="Wrap" Margin="0,10,0,0" MinHeight="18" />
        <TextBlock TextWrapping="Wrap" FontSize="11.5" Opacity="0.75" Margin="0,4,0,0"
                   Text="A game linked under Game layouts still wins while it's in front; the schedule fills in what its link doesn't set." />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="OkButton" Content="Add" IsDefault="True" Click="OnOk" MinWidth="80"
                    Style="{DynamicResource AccentButtonStyle}" />
            <Button Content="Cancel" IsCancel="True" Margin="8,0,0,0" MinWidth="80" />
        </StackPanel>
    </StackPanel>
</Window>
