<Window x:Class="ImpiousBonum.App.Shell.WeatherLocationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:ImpiousBonum.App.Controls"
        ThemeMode="System"
        Title="Weather location"
        Width="480" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Style="{DynamicResource DialogFooter}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="OkButton" Content="Use this place" IsDefault="True" IsEnabled="False" Click="OnOk" MinWidth="{DynamicResource DialogButtonWidth}"
                        Style="{DynamicResource AccentButtonStyle}" />
                <Button Content="Cancel" IsCancel="True" Margin="{DynamicResource ButtonGap}" MinWidth="{DynamicResource DialogButtonWidth}" />
            </StackPanel>
        </Border>
        <StackPanel Margin="{DynamicResource DialogPadding}">
            <TextBlock Text="Where should the forecast be for?" Style="{DynamicResource SectionHeading}" />
            <DockPanel>
                <Button x:Name="SearchButton" DockPanel.Dock="Right" Margin="{DynamicResource ButtonGap}" MinWidth="{DynamicResource DialogButtonWidth}" Click="OnSearch">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{DynamicResource ButtonGlyph}" Text="&#xE721;" />
                        <TextBlock Text="Search" />
                    </StackPanel>
                </Button>
                <TextBox x:Name="QueryBox" TextChanged="OnQueryChanged" KeyDown="OnQueryKeyDown"
                         c:Placeholder.Text="A town or city, or latitude, longitude" />
            </DockPanel>
            <ListBox x:Name="Results" Height="190" Margin="0,10,0,0" SelectionChanged="OnSelectionChanged" MouseDoubleClick="OnOk" />
            <TextBlock x:Name="StatusText" Style="{DynamicResource SecondaryText}" Margin="0,8,0,0" MinHeight="18" />
            <TextBlock Style="{DynamicResource NoteText}" Margin="0,8,0,0"
                       Text="The place you pick is sent to Open-Meteo.com to get the forecast, every 15 minutes. Nothing else is sent." />
        </StackPanel>
    </DockPanel>
</Window>
