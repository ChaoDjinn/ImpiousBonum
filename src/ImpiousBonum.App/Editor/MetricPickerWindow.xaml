<Window x:Class="ImpiousBonum.App.Editor.MetricPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:ImpiousBonum.App.Controls"
        Title="Insert metric"
        ThemeMode="System"
        Width="780" Height="820" MinWidth="540" MinHeight="500"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Style="{DynamicResource DialogFooter}">
            <DockPanel LastChildFill="False">
                <TextBlock x:Name="ResultText" DockPanel.Dock="Left" VerticalAlignment="Center" Style="{DynamicResource CodeText}" />
                <Button DockPanel.Dock="Right" Content="Cancel" IsCancel="True" Margin="{DynamicResource ButtonGap}" MinWidth="{DynamicResource DialogButtonWidth}" />
                <Button x:Name="InsertButton" DockPanel.Dock="Right" Content="Insert" IsDefault="True" Click="OnInsert" MinWidth="{DynamicResource DialogButtonWidth}"
                        Style="{DynamicResource AccentButtonStyle}" />
            </DockPanel>
        </Border>

        <DockPanel Margin="16,16,16,12">
            <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                <TextBox x:Name="SearchBox" TextChanged="OnSearchChanged"
                         c:Placeholder.Text="Search by name, id or hardware, e.g. gpu temp or core #3" />
                <TextBlock Style="{DynamicResource Glyph}" Text="&#xE721;" Margin="0,0,12,0" HorizontalAlignment="Right" IsHitTestVisible="False"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </Grid>

            <StackPanel x:Name="FormatPanel" DockPanel.Dock="Bottom" Margin="0,12,0,0">
                <TextBlock Text="Show it as" Style="{DynamicResource SectionHeading}" />
                <ListBox x:Name="FormatList" SelectionChanged="OnFormatChanged" MouseDoubleClick="OnInsert" MaxHeight="190">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Example}" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" Text="{Binding Description}" Style="{DynamicResource SecondaryText}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>

            <ListView x:Name="MetricList" SelectionChanged="OnMetricChanged" MouseDoubleClick="OnMetricDoubleClick"
                      VirtualizingPanel.IsVirtualizingWhenGrouping="True" VirtualizingPanel.VirtualizationMode="Recycling"
                      c:Placeholder.Text="No metrics match. Try fewer words, or part of an id like temp or core.">
                <ListView.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" Style="{DynamicResource SectionHeading}" Margin="4,12,0,4" />
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ListView.GroupStyle>
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Name" Width="260" DisplayMemberBinding="{Binding Name}" />
                        <GridViewColumn Header="Now" Width="120" DisplayMemberBinding="{Binding Value}" />
                        <GridViewColumn Header="Id" Width="290">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Id}" Style="{DynamicResource CodeText}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </DockPanel>
    </DockPanel>
</Window>
