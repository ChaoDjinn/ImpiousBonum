<Window x:Class="ImpiousBonum.App.Editor.AddWidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:ImpiousBonum.App.Controls"
        Title="Add a widget"
        ThemeMode="System"
        Width="1040" Height="740" MinWidth="660" MinHeight="460"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Window.Resources>
        <!-- A widget as a card: its picture, its name and what it's for, outlined in the accent colour when chosen. -->
        <Style x:Key="WidgetCard" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="6" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
            <Setter Property="AutomationProperties.HelpText" Value="{Binding Descriptor.Description}" />
            <Setter Property="ToolTip" Value="{Binding Descriptor.Description}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Back" Width="232" Padding="10" CornerRadius="8" BorderThickness="1"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Back" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Back" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                <Setter TargetName="Back" Property="BorderThickness" Value="2" />
                                <Setter TargetName="Back" Property="Padding" Value="9" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Bottom" Style="{DynamicResource DialogFooter}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Cancel" IsCancel="True" Margin="{DynamicResource ButtonGap}" MinWidth="{DynamicResource DialogButtonWidth}" />
                <Button x:Name="AddButton" DockPanel.Dock="Right" Content="Add" IsDefault="True" Click="OnAdd" MinWidth="{DynamicResource DialogButtonWidth}"
                        Style="{DynamicResource AccentButtonStyle}" />
                <TextBlock x:Name="ChosenText" VerticalAlignment="Center" Margin="0,0,16,0" TextTrimming="CharacterEllipsis" Style="{DynamicResource SecondaryText}" />
            </DockPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <DockPanel Margin="16,16,8,12">
                <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                    <TextBox x:Name="SearchBox" TextChanged="OnSearchChanged" PreviewKeyDown="OnSearchKeyDown"
                             c:Placeholder.Text="Find a widget" AutomationProperties.Name="Find a widget" />
                    <TextBlock Style="{DynamicResource Glyph}" Text="&#xE721;" Margin="0,0,12,0" HorizontalAlignment="Right" IsHitTestVisible="False"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </Grid>
                <ListBox x:Name="GroupList" BorderThickness="0" Background="Transparent" Padding="0" SelectionChanged="OnGroupChanged"
                         ItemContainerStyle="{DynamicResource NavItem}" AutomationProperties.Name="Groups">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Count}" Style="{DynamicResource SecondaryText}" Margin="8,0,0,0" />
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <ListBox x:Name="WidgetList" Grid.Column="1" Margin="8,10,10,6" BorderThickness="0" Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="OnWidgetChanged" MouseDoubleClick="OnWidgetDoubleClick"
                     ItemContainerStyle="{StaticResource WidgetCard}" AutomationProperties.Name="Widgets"
                     c:Placeholder.Text="No widget matches. Try fewer words, or what it shows, like weather or temperature.">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <Border Height="124" CornerRadius="4" ClipToBounds="True" Background="{Binding Backdrop}">
                                <Image Source="{Binding Preview}" Stretch="Uniform" Margin="4" RenderOptions.BitmapScalingMode="HighQuality" />
                            </Border>
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="0,8,0,0" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Summary}" Style="{DynamicResource SecondaryText}" Margin="0,2,0,0" TextWrapping="Wrap"
                                       Height="38" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </DockPanel>
</Window>
