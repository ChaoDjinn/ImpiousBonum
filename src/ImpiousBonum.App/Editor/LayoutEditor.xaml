<UserControl x:Class="ImpiousBonum.App.Editor.LayoutEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- Toolbar buttons: an icon, and a label for the ones used most. -->
        <Style x:Key="ToolbarSeparator" TargetType="Border">
            <Setter Property="Width" Value="1" />
            <Setter Property="Margin" Value="10,6" />
            <Setter Property="Background" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
        </Style>
    </UserControl.Resources>
    <DockPanel>
        <!-- What's being edited: a screen's dashboard, and the saved layout it shows. -->
        <Border DockPanel.Dock="Top" Padding="16,12,16,10" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <TextBlock Style="{DynamicResource Glyph}" Text="&#xE7F4;" Margin="0,0,8,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="Screen" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <ComboBox x:Name="ScreenBox" Width="280" SelectionChanged="OnScreenBoxChanged" AutomationProperties.Name="Screen"
                              ToolTip="The screen whose dashboard you're editing. Each screen's dashboard shows a layout of its own; add dashboards to more screens on the Screens page." />
                    <TextBlock Style="{DynamicResource Glyph}" Text="&#xE8A9;" Margin="20,0,8,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="Layout" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <ComboBox x:Name="LayoutBox" Width="220" SelectionChanged="OnLayoutBoxChanged" Margin="0,0,6,0" AutomationProperties.Name="Layout"
                              ToolTip="The saved layout you're editing, which that screen's dashboard shows. Pick another to show and edit that one." />
                    <Button x:Name="LayoutMenuButton" Click="OnLayoutMenu"
                            ToolTip="New, save as, rename, duplicate, export, import or delete layouts, or get one from the gallery">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Layouts" />
                            <TextBlock Style="{DynamicResource Glyph}" Text="&#xE70D;" FontSize="10" Margin="8,1,0,0" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button x:Name="RevertButton" Click="OnRevert" ToolTip="Go back to the last saved layout">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{DynamicResource ButtonGlyph}" Text="&#xE777;" />
                            <TextBlock Text="Revert" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="SaveButton" Click="OnSave" Margin="6,0,0,0" Style="{DynamicResource AccentButtonStyle}" ToolTip="Save (Ctrl+S)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{DynamicResource ButtonGlyph}" Text="&#xE74E;" />
                            <TextBlock Text="Save" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Editing tools -->
        <Border DockPanel.Dock="Top" Padding="16,8" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="AddButton" Click="OnAdd" ToolTip="Add a widget to the layout">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{DynamicResource ButtonGlyph}" Text="&#xE710;" />
                        <TextBlock Text="Add widget" />
                        <TextBlock Style="{DynamicResource Glyph}" Text="&#xE70D;" FontSize="10" Margin="8,1,0,0" />
                    </StackPanel>
                </Button>
                <Border Style="{StaticResource ToolbarSeparator}" />
                <Button x:Name="DuplicateButton" Click="OnDuplicate" ToolTip="Duplicate (Ctrl+D)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{DynamicResource ButtonGlyph}" Text="&#xE8C8;" />
                        <TextBlock Text="Duplicate" />
                    </StackPanel>
                </Button>
                <Button x:Name="DeleteButton" Click="OnDelete" Margin="6,0,0,0" ToolTip="Delete (Del)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{DynamicResource ButtonGlyph}" Text="&#xE74D;" />
                        <TextBlock Text="Delete" />
                    </StackPanel>
                </Button>
                <Border Style="{StaticResource ToolbarSeparator}" />
                <Button x:Name="UndoButton" Click="OnUndo" ToolTip="Undo (Ctrl+Z)">
                    <TextBlock Style="{DynamicResource Glyph}" Text="&#xE7A7;" />
                </Button>
                <Button x:Name="RedoButton" Click="OnRedo" Margin="6,0,0,0" ToolTip="Redo (Ctrl+Y)">
                    <TextBlock Style="{DynamicResource Glyph}" Text="&#xE7A6;" />
                </Button>
                <Border Style="{StaticResource ToolbarSeparator}" />
                <TextBlock Style="{DynamicResource Glyph}" Text="&#xE80A;" Margin="0,0,8,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           ToolTip="Snap to a grid" />
                <ComboBox x:Name="SnapBox" Width="96" SelectionChanged="OnSnapChanged" ToolTip="Grid size for moving and resizing. Hold Alt while dragging to place freely." />
            </StackPanel>
        </Border>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" Padding="16,6" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
            <DockPanel>
                <StackPanel x:Name="IssuesPanel" DockPanel.Dock="Right" Orientation="Horizontal" Visibility="Collapsed">
                    <TextBlock Style="{DynamicResource Glyph}" Text="&#xE7BA;" FontSize="12" Margin="0,0,6,0" Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
                    <TextBlock x:Name="IssuesText" Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
                </StackPanel>
                <TextBlock x:Name="StatusText" Style="{DynamicResource SecondaryText}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="440" />
            </Grid.ColumnDefinitions>

            <!-- Widget list, in drawing order: drag a widget up or down it to reorder, or right-click for its menu. -->
            <DockPanel Grid.Column="0" Margin="12,14,6,12">
                <TextBlock DockPanel.Dock="Top" Text="Widgets" Style="{DynamicResource SectionHeading}" Margin="4,0,0,8" />
                <TextBlock DockPanel.Dock="Bottom" Style="{DynamicResource NoteText}" Margin="4,10,0,0"
                           Text="Lower in the list draws on top: drag a widget up or down to change the order. Click empty canvas (or press Esc) for canvas and theme settings." />
                <ListBox x:Name="WidgetList" SelectionChanged="OnListSelectionChanged" ContextMenuOpening="OnListMenuOpening"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock TextTrimming="CharacterEllipsis" ToolTip="{Binding ToolTip}">
                                <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="{Binding Detail, Mode=OneWay}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </TextBlock>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <!-- Preview, on a stage of its own so the canvas edge is clear whatever its background. -->
            <Border Grid.Column="1" Margin="6,14,6,12" Style="{DynamicResource Card}" Padding="16">
                <ContentControl x:Name="PreviewHost" />
            </Border>

            <!-- Properties -->
            <Border Grid.Column="2" BorderThickness="1,0,0,0" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ContentControl x:Name="PropertiesHost" />
                </ScrollViewer>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
