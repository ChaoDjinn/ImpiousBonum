<Window x:Class="ImpiousBonum.App.Editor.NamePromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        ThemeMode="System"
        Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Style="{DynamicResource DialogFooter}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="OkButton" Content="OK" IsDefault="True" Click="OnOk" MinWidth="{DynamicResource DialogButtonWidth}"
                        Style="{DynamicResource AccentButtonStyle}" />
                <Button Content="Cancel" IsCancel="True" Margin="{DynamicResource ButtonGap}" MinWidth="{DynamicResource DialogButtonWidth}" />
            </StackPanel>
        </Border>
        <StackPanel Margin="{DynamicResource DialogPadding}">
            <TextBlock x:Name="PromptText" Margin="0,0,0,8" />
            <TextBox x:Name="NameBox" TextChanged="OnNameChanged" />
            <TextBlock x:Name="ErrorText" Style="{DynamicResource ProblemText}" Margin="0,8,0,0" />
        </StackPanel>
    </DockPanel>
</Window>
