<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- WinForms is only used for the tray icon (NotifyIcon) and the editor's colour picker. -->
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>ImpiousBonum</AssemblyName>
    <RootNamespace>ImpiousBonum.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\assets\ImpiousBonum.ico</ApplicationIcon>
    <!-- Program.Main runs Velopack's install/update hooks before WPF starts. -->
    <StartupObject>ImpiousBonum.App.Program</StartupObject>
    <!-- Keep the idle footprint small: no background GC thread, workstation GC. -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <!-- WPF0001: Window.ThemeMode (Fluent theme for the editor) is marked experimental. -->
    <!-- WFO0003 wants DPI set via the WinForms API; this is a WPF app, so the manifest is the right place. -->
    <NoWarn>$(NoWarn);WFO0003;WPF0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ImpiousBonum.App.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <!-- App.xaml is a plain page so WPF doesn't generate a Main of its own. -->
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Layout\default-layout.json" LogicalName="ImpiousBonum.default-layout.json" />
    <!-- Built-in themes, found by their "ImpiousBonum.themes." prefix. -->
    <EmbeddedResource Include="Layout\Themes\*.json" LogicalName="ImpiousBonum.themes.%(Filename)%(Extension)" />
    <!-- Public half of the update signing key. Without it the app refuses every update (and build/publish.ps1 refuses to release). -->
    <EmbeddedResource Include="..\..\assets\update-signing-key.pub" LogicalName="ImpiousBonum.update-signing-key.pub" Condition="Exists('..\..\assets\update-signing-key.pub')" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ImpiousBonum.Core\ImpiousBonum.Core.csproj" />
    <!-- Build order only. The host runs as its own process, so none of its assemblies (LibreHardwareMonitor etc.) load into the dashboard. -->
    <ProjectReference Include="..\ImpiousBonum.Sensors\ImpiousBonum.Sensors.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Velopack" Version="1.2.158" />
  </ItemGroup>

  <!-- Ship the sensor host alongside the dashboard in a "sensors" subfolder with its own dependencies. -->
  <Target Name="CopySensorHost" AfterTargets="Build">
    <MSBuild Projects="..\ImpiousBonum.Sensors\ImpiousBonum.Sensors.csproj" Targets="GetTargetPath" Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" PropertyName="SensorHostAssembly" />
    </MSBuild>
    <PropertyGroup>
      <SensorHostDirectory>$([System.IO.Path]::GetDirectoryName($(SensorHostAssembly)))</SensorHostDirectory>
    </PropertyGroup>
    <ItemGroup>
      <SensorHostFiles Include="$(SensorHostDirectory)\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(SensorHostFiles)" DestinationFiles="@(SensorHostFiles->'$(OutDir)sensors\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

</Project>
