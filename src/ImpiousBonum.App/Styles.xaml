<!--
    Shared look for the editor and dialogs, on top of WPF's Fluent theme (each window sets ThemeMode="System").
    Colours come from the theme's own brushes, so everything follows Windows' light or dark mode; refer to these
    styles with DynamicResource, since the theme's brushes live in each window's resources.
    Only text and layout styles here: a keyed Button style would replace the Fluent one rather than add to it.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Room around a dialog's content, and between its buttons. -->
    <Thickness x:Key="DialogPadding">24,20,24,20</Thickness>
    <Thickness x:Key="ButtonGap">8,0,0,0</Thickness>
    <sys:Double x:Key="DialogButtonWidth" xmlns:sys="clr-namespace:System;assembly=System.Runtime">96</sys:Double>

    <!-- Less important text: explanations under a field, notes at the foot of a dialog. -->
    <Style x:Key="SecondaryText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="NoteText" TargetType="TextBlock" BasedOn="{StaticResource SecondaryText}">
        <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- What stops a dialog being saved. Hidden until the user starts filling it in (see Dialog.ShowAfterInput). -->
    <Style x:Key="ProblemText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="MinHeight" Value="18" />
    </Style>

    <Style x:Key="SectionHeading" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>

    <Style x:Key="CodeText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>

    <!-- An icon from Segoe Fluent Icons (Windows 11) or Segoe MDL2 Assets (Windows 10), e.g. inside a button. -->
    <Style x:Key="Glyph" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextOptions.TextRenderingMode" Value="Grayscale" />
    </Style>

    <Style x:Key="ButtonGlyph" TargetType="TextBlock" BasedOn="{StaticResource Glyph}">
        <Setter Property="Margin" Value="0,0,8,0" />
    </Style>

    <!-- The band along the bottom of a dialog that holds its buttons, as in Windows 11's own dialogs. -->
    <Style x:Key="DialogFooter" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SolidBackgroundFillColorSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="Padding" Value="24,16" />
    </Style>

    <!-- A group of related settings, raised slightly from the window. -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="12,10" />
    </Style>

    <Style x:Key="Divider" TargetType="Border">
        <Setter Property="BorderBrush" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
    </Style>

    <!-- ==== The main window: its sidebar, its pages and their settings cards ==== -->

    <!-- A page's name at its top, as in Windows 11's Settings. -->
    <Style x:Key="PageTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>

    <!-- What a page is for, under its title. -->
    <Style x:Key="PageIntro" TargetType="TextBlock" BasedOn="{StaticResource SecondaryText}">
        <Setter Property="Margin" Value="0,0,0,20" />
        <Setter Property="MaxWidth" Value="760" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <!-- A group of cards on a page. -->
    <Style x:Key="GroupHeading" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Margin" Value="2,18,0,8" />
    </Style>

    <!-- A page's content (a Controls.PageColumn): a column on the left that stops growing on wide windows, like Settings' own. -->
    <Style x:Key="PageColumn" TargetType="StackPanel">
        <Setter Property="Margin" Value="40,28,40,40" />
        <Setter Property="MaxWidth" Value="1000" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <!-- A CheckBox drawn as Windows 11's toggle switch, with "On" or "Off" beside it. -->
    <Style x:Key="ToggleSwitch" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <TextBlock x:Name="State" Text="Off" Width="28" TextAlignment="Right" Margin="0,0,12,0" VerticalAlignment="Center" />
                        <Border x:Name="Track" Width="40" Height="20" CornerRadius="10" BorderThickness="1" VerticalAlignment="Center"
                                Background="{DynamicResource ToggleSwitchFillOff}" BorderBrush="{DynamicResource ToggleSwitchStrokeOff}">
                            <Ellipse x:Name="Knob" Width="12" Height="12" HorizontalAlignment="Left" Margin="3,0,0,0"
                                     Fill="{DynamicResource ToggleSwitchKnobFillOff}" />
                        </Border>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource ToggleSwitchFillOffPointerOver}" />
                            <Setter TargetName="Knob" Property="Width" Value="14" />
                            <Setter TargetName="Knob" Property="Height" Value="14" />
                            <Setter TargetName="Knob" Property="Margin" Value="2,0,0,0" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="State" Property="Text" Value="On" />
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource ToggleSwitchFillOn}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource ToggleSwitchStrokeOn}" />
                            <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource ToggleSwitchKnobFillOn}" />
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="Knob" Property="Margin" Value="0,0,3,0" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="True" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource ToggleSwitchFillOnPointerOver}" />
                            <Setter TargetName="Knob" Property="Margin" Value="0,0,2,0" />
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="State" Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource ToggleSwitchFillOffDisabled}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource ToggleSwitchStrokeOffDisabled}" />
                            <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource ToggleSwitchKnobFillOffDisabled}" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="True" />
                                <Condition Property="IsEnabled" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource ToggleSwitchFillOnDisabled}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource ToggleSwitchStrokeOnDisabled}" />
                            <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource ToggleSwitchKnobFillOnDisabled}" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A page in the sidebar: a rounded highlight, with the accent's bar on the left of the one showing. -->
    <Style x:Key="NavItem" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Back" CornerRadius="4" Margin="0,1" MinHeight="36" Background="Transparent">
                        <Grid>
                            <Border x:Name="Bar" Width="3" Height="16" CornerRadius="1.5" HorizontalAlignment="Left"
                                    Background="{DynamicResource AccentFillColorDefaultBrush}" Visibility="Hidden" />
                            <ContentPresenter Margin="14,0,10,0" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Back" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Back" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Back" Property="BorderBrush" Value="{DynamicResource FocusStrokeColorOuterBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A thin line between groups of pages in the sidebar. -->
    <Style x:Key="NavSeparator" TargetType="ListBoxItem">
        <Setter Property="IsEnabled" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border Height="1" Margin="10,6" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="c:SettingsCard" xmlns:c="clr-namespace:ImpiousBonum.App.Controls">
        <Setter Property="Margin" Value="0,0,0,4" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="c:SettingsCard">
                    <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="6">
                        <StackPanel>
                            <Grid Margin="16,12" MinHeight="44">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="Icon" Style="{StaticResource Glyph}" FontSize="20" Margin="2,0,18,0" Text="{TemplateBinding Glyph}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{TemplateBinding Header}" TextWrapping="Wrap" />
                                    <TextBlock x:Name="Description" Text="{TemplateBinding Description}" Style="{StaticResource NoteText}" Margin="0,2,0,0" />
                                </StackPanel>
                                <ContentPresenter Grid.Column="2" Margin="20,0,0,0" VerticalAlignment="Center" />
                            </Grid>
                            <Border x:Name="DetailArea" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Padding="56,12,16,14">
                                <ContentPresenter Content="{TemplateBinding Detail}" />
                            </Border>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Glyph" Value="{x:Null}">
                            <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Description" Value="{x:Null}">
                            <Setter TargetName="Description" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Description" Value="">
                            <Setter TargetName="Description" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Detail" Value="{x:Null}">
                            <Setter TargetName="DetailArea" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.55" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
