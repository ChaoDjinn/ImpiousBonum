// Every CPU thread as a heatmap, and bars, for the README and the guide (build/screenshots.ps1).
{
  "width": 800,
  "height": 400,
  "theme": "Orange",
  "widgets": [
    { "type": "text", "x": 30, "y": 20, "width": 350, "height": 44, "fontSize": 26, "text": "CPU threads · {cpu.load}" },
    { "type": "cores", "x": 30, "y": 80, "width": 350, "height": 300, "style": "heatmap" },
    { "type": "bars", "x": 420, "y": 20, "width": 350, "height": 360, "fontSize": 26, "spacing": 22,
      "bars": [
        { "label": "CPU", "metric": "cpu.load" },
        { "label": "GPU", "metric": "gpu.load" },
        { "label": "RAM", "metric": "mem.used", "text": "{mem.used} / {mem.total}" },
        { "label": "GPU memory", "metric": "gpu.vram.used" }
      ] }
  ]
}
