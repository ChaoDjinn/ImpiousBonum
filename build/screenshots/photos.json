// A photo frame with the date the photo was taken, beside the time, for the guide (build/screenshots.ps1). With no
// folder, the demo shows a made-up photo.
{
  "width": 800,
  "height": 400,
  "theme": "Orange",
  "widgets": [
    { "type": "photos", "x": 20, "y": 20, "width": 520, "height": 360, "caption": "date", "cornerRadius": 16, "fontSize": 20 },
    { "type": "clock", "x": 560, "y": 20, "width": 220, "height": 360, "timeSize": 70, "dateSize": 18, "dateFormat": "dddd d MMMM" }
  ]
}
