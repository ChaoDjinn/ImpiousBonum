// What's playing, and buttons, for the README and the guide (build/screenshots.ps1).
{
  "width": 800,
  "height": 400,
  "theme": "Orange",
  "widgets": [
    { "type": "media", "x": 30, "y": 20, "width": 740, "height": 170, "fontSize": 34, "controlSize": 48 },
    { "type": "buttons", "x": 30, "y": 230, "width": 740, "height": 150, "fontSize": 20, "iconSize": 40,
      "buttons": [
        { "label": "Mute mic", "icon": "mute", "action": "keys", "target": "Ctrl+Shift+M" },
        { "label": "Screenshot", "icon": "camera", "action": "keys", "target": "Win+Shift+S" },
        { "label": "Gaming", "icon": "gamepad", "action": "layout", "target": "Gaming" },
        { "label": "Sound", "icon": "sliders", "action": "open", "target": "ms-settings:sound" }
      ] }
  ]
