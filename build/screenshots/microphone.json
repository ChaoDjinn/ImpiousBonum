// The microphone and camera, streamer-style, for the guide (build/screenshots.ps1).
{
  "width": 800,
  "height": 240,
  "theme": "Orange",
  "widgets": [
    { "type": "text", "x": 30, "y": 20, "width": 200, "height": 70, "fontSize": 48, "text": "● MIC", "color": "track",
      "thresholds": [{ "metric": "mic.inuse", "above": 0, "color": "critical" }] },
    { "type": "text", "x": 250, "y": 20, "width": 300, "height": 70, "fontSize": 48, "text": "● CAMERA", "color": "track",
      "thresholds": [{ "metric": "camera.inuse", "above": 0, "color": "critical" }] },
    { "type": "icon", "x": 30, "y": 115, "width": 520, "height": 56, "icon": "mic", "text": "{mic.name}", "fontSize": 34, "iconSize": 48, "gap": 20,
      "thresholds": [{ "metric": "mic.muted", "above": 0, "color": "critical" }] },
    { "type": "text", "x": 98, "y": 176, "width": 452, "height": 40, "fontSize": 26, "text": "In use by {mic.apps}", "color": "secondary",
      "hideUnavailable": true },
    { "type": "buttons", "x": 590, "y": 20, "width": 180, "height": 200, "fontSize": 22, "iconSize": 64,
      "buttons": [{ "label": "Mute", "icon": "mic", "action": "mic-mute" }] }
  ]
}
