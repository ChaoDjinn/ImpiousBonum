// Graphs and a multi-line graph, for the README and the guide (build/screenshots.ps1).
{
  "width": 800,
  "height": 400,
  "theme": "Orange",
  "widgets": [
    { "type": "graph", "x": 30, "y": 20, "width": 350, "height": 170, "label": "CPU", "metric": "cpu.load", "style": "line" },
    { "type": "graph", "x": 30, "y": 210, "width": 350, "height": 170, "label": "Memory", "text": "{mem.used} / {mem.total}",
      "metric": "mem.used", "style": "area" },
    { "type": "lines", "x": 420, "y": 20, "width": 350, "height": 360, "fontSize": 24,
      "lines": [
        { "label": "CPU", "metric": "cpu.load", "color": "accent" },
        { "label": "GPU", "metric": "gpu.load", "color": "#4FC3F7" }
      ] }
  ]
}
