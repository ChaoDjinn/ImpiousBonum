// The frame rate, the 1% and 0.1% lows and frame times, for the README and the guide (build/screenshots.ps1).
{
  "width": 800,
  "height": 400,
  "theme": "Orange",
  "widgets": [
    { "type": "stat", "x": 30, "y": 20, "width": 340, "height": 170, "label": "FPS", "metric": "fps", "text": "{fps:0 nounit}", "fontSize": 64 },
    { "type": "stat", "x": 30, "y": 210, "width": 340, "height": 170, "label": "1% low", "metric": "fps.low1", "text": "{fps.low1:0 nounit}",
      "fontSize": 64 },
    { "type": "lines", "x": 410, "y": 20, "width": 360, "height": 170, "fontSize": 22,
      "lines": [
        { "label": "Frame time", "metric": "fps.frametime", "color": "accent" },
        { "label": "Slowest", "metric": "fps.frametime.max", "color": "#4FC3F7" }
      ] },
    { "type": "stat", "x": 410, "y": 210, "width": 360, "height": 170, "label": "0.1% low", "metric": "fps.low01",
      "text": "{fps.low01:0 nounit}", "fontSize": 64 }
  ]
}
