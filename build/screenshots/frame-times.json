// The frame rate, the 1% low and frame times, for the README and the guide (build/screenshots.ps1).
{
  "width": 800,
  "height": 400,
  "theme": "Orange",
  "widgets": [
    { "type": "stat", "x": 30, "y": 20, "width": 300, "height": 170, "label": "FPS", "metric": "fps", "text": "{fps:0 nounit}", "fontSize": 64 },
    { "type": "stat", "x": 30, "y": 210, "width": 300, "height": 170, "label": "1% low", "metric": "fps.low1", "text": "{fps.low1:0 nounit}",
      "fontSize": 64 },
    { "type": "lines", "x": 370, "y": 20, "width": 400, "height": 360, "fontSize": 24,
      "lines": [
        { "label": "Frame time", "metric": "fps.frametime", "color": "accent" },
        { "label": "Slowest", "metric": "fps.frametime.max", "color": "warning" }
      ] }
  ]
}
