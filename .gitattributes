# Normalise line endings in the repo; check out with the platform's native endings.
* text=auto

# C# and XAML check out with Windows line endings everywhere, which dotnet format (run by CI) expects.
*.cs      text eol=crlf diff=csharp
*.xaml    text eol=crlf
*.csproj  text
*.slnx    text
*.props   text
*.json    text
*.md      text
*.manifest text

*.png     binary
*.ico     binary
*.otf     binary
*.ttf     binary
