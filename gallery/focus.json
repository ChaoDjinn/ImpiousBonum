// Focus: a 25-minute timer (tap to start), today's agenda, the time and something to listen to.
{
  "width": 1920,
  "height": 480,
  "theme": "Rose Pine",
  "widgets": [
    { "type": "timer", "x": 40, "y": 30, "width": 560, "height": 420, "mode": "countdown", "duration": "25:00",
      "label": "Focus", "doneText": "Take a break", "fontSize": 150, "labelSize": 30 },
    { "type": "agenda", "x": 650, "y": 20, "width": 560, "height": 440, "days": 1, "count": 8, "fontSize": 24, "dayHeaders": false,
      "emptyText": "Nothing else today" },
    { "type": "clock", "x": 1260, "y": 10, "width": 620, "height": 270, "timeSize": 140, "dateSize": 26 },
    { "type": "media", "x": 1260, "y": 300, "width": 620, "height": 160, "fontSize": 30, "controlSize": 48 }
  ]
}
