// Streamer: for a 7" 1024 × 600 touch screen beside your stream. The scene buttons send F13 to F17 (set them as
// hotkeys in OBS or your streaming app), and Ctrl+Shift+M mutes your mic in Discord; tap On air to time the stream.
// Below: your frame rate, upload speed and how hard the CPU and GPU are working. Needs the sensor service for FPS.
{
  "width": 1024,
  "height": 600,
  "theme": "Cyberpunk",
  "widgets": [
    { "type": "buttons", "x": 20, "y": 20, "width": 640, "height": 360, "columns": 3, "fontSize": 20, "iconSize": 48, "spacing": 12,
      "buttons": [
        { "label": "Starting", "icon": "play", "action": "keys", "target": "F13" },
        { "label": "Gameplay", "icon": "gamepad", "action": "keys", "target": "F14" },
        { "label": "Be right back", "icon": "moon", "action": "keys", "target": "F15" },
        { "label": "Ending", "icon": "stop", "action": "keys", "target": "F16" },
        { "label": "Clip it", "icon": "camera", "action": "keys", "target": "F17" },
        { "label": "Mute mic", "icon": "mute", "action": "keys", "target": "Ctrl+Shift+M" }
      ] },
    { "type": "timer", "x": 680, "y": 20, "width": 324, "height": 170, "mode": "stopwatch", "label": "On air", "fontSize": 64 },
    { "type": "stat", "x": 680, "y": 210, "width": 324, "height": 170, "label": "FPS", "metric": "fps", "text": "{fps:0 nounit}", "fontSize": 56,
      "thresholds": [{ "below": 50, "color": "warning" }, { "below": 30, "color": "critical" }] },
    { "type": "stat", "x": 20, "y": 400, "width": 312, "height": 180, "label": "Upload", "metric": "net.up", "fontSize": 48 },
    { "type": "stat", "x": 356, "y": 400, "width": 312, "height": 180, "label": "CPU", "metric": "cpu.load", "fontSize": 48,
      "thresholds": [{ "above": 85, "color": "warning" }] },
    { "type": "stat", "x": 692, "y": 400, "width": 312, "height": 180, "label": "GPU", "metric": "gpu.load", "fontSize": 48 }
  ]
}
