// Desk companion: the time here and in two other places, what's on today, the weather and what's playing.
// Set your calendars on the Calendars page and your location on the Weather page; change the places in the editor.
{
  "width": 1920,
  "height": 480,
  "theme": "Nord",
  "widgets": [
    { "type": "clock", "x": 40, "y": 10, "width": 560, "height": 460, "timeSize": 140, "dateSize": 28,
      "zoneSize": 26, "zoneLayout": "columns",
      "zones": [
        { "label": "London", "zone": "Europe/London" },
        { "label": "New York", "zone": "America/New_York" },
        { "label": "Tokyo", "zone": "Asia/Tokyo" }
      ] },
    { "type": "agenda", "x": 650, "y": 20, "width": 560, "height": 440, "days": 2, "count": 7, "fontSize": 22 },
    { "type": "weather", "x": 1260, "y": 10, "width": 620, "height": 300, "fontSize": 72, "forecastSize": 20, "count": 4 },
    { "type": "media", "x": 1260, "y": 330, "width": 620, "height": 130, "fontSize": 28, "controlSize": 44 }
  ]
}
