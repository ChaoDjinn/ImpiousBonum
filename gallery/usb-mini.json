// USB mini: for a 3.5" 480 × 320 USB screen (Turing Smart Screen and its clones). The time, and the CPU and GPU
// temperatures as dials. Show it there from the Tablet and USB screen page; temperatures need the sensor service.
{
  "width": 480,
  "height": 320,
  "theme": "Amber",
  "widgets": [
    { "type": "clock", "x": 10, "y": 6, "width": 460, "height": 140, "timeSize": 92, "dateSize": 18 },
    { "type": "gauge", "x": 20, "y": 160, "width": 210, "height": 150, "label": "CPU °C", "metric": "cpu.temp", "text": "{cpu.temp:nounit}",
      "max": 100, "thickness": 10, "fontSize": 40, "labelSize": 16, "thresholds": [{ "above": 80, "color": "warning" }, { "above": 90, "color": "critical" }] },
    { "type": "gauge", "x": 250, "y": 160, "width": 210, "height": 150, "label": "GPU °C", "metric": "gpu.temp", "text": "{gpu.temp:nounit}",
      "max": 100, "thickness": 10, "fontSize": 40, "labelSize": 16, "thresholds": [{ "above": 80, "color": "warning" }, { "above": 88, "color": "critical" }] }
  ]
}
