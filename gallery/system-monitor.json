// System monitor: loads and network over time, every CPU thread, the busiest apps, drives and memory.
{
  "width": 1920,
  "height": 480,
  "theme": "Tokyo Night",
  "widgets": [
    { "type": "lines", "x": 30, "y": 20, "width": 600, "height": 200, "fontSize": 20,
      "lines": [
        { "label": "CPU", "metric": "cpu.load", "color": "accent" },
        { "label": "GPU", "metric": "gpu.load", "color": "warning" }
      ] },
    { "type": "lines", "x": 30, "y": 250, "width": 600, "height": 210, "fontSize": 20,
      "lines": [
        { "label": "Down", "metric": "net.down", "color": "accent" },
        { "label": "Up", "metric": "net.up", "color": "critical" }
      ] },
    { "type": "cores", "x": 670, "y": 20, "width": 420, "height": 200, "style": "heatmap" },
    { "type": "processes", "x": 670, "y": 250, "width": 420, "height": 210, "count": 5, "fontSize": 22 },
    { "type": "drives", "x": 1130, "y": 20, "width": 360, "height": 300, "fontSize": 22 },
    { "type": "rows", "x": 1130, "y": 350, "width": 360, "height": 110, "fontSize": 24, "align": "bottom",
      "rows": [
        { "label": "Ping", "text": "{net.ping}" },
        { "label": "Up for", "text": "{sys.uptime}" }
      ] },
    { "type": "gauge", "x": 1530, "y": 20, "width": 360, "height": 230, "label": "RAM", "metric": "mem.load", "text": "{mem.used:GB}",
      "fontSize": 44, "thresholds": [{ "above": 85, "color": "warning" }, { "above": 95, "color": "critical" }] },
    { "type": "stat", "x": 1530, "y": 270, "width": 360, "height": 190, "label": "Disk activity", "metric": "disk.C.active", "fontSize": 48 }
  ]
}
