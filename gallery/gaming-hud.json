// Gaming HUD: frame rate front and centre, frame times, temperatures and how the session is going.
// Needs the sensor service for FPS and temperatures; link your games under tray → Layout → Game layouts for the session line.
{
  "width": 1920,
  "height": 480,
  "theme": "Outrun",
  "widgets": [
    { "type": "text", "x": 40, "y": 10, "width": 420, "height": 190, "fontSize": 160, "text": "{fps:0 nounit}",
      "thresholds": [{ "below": 50, "color": "warning" }, { "below": 30, "color": "critical" }] },
    { "type": "text", "x": 40, "y": 200, "width": 420, "height": 40, "fontSize": 30, "text": "FPS · {fps.app}", "color": "secondary" },
    { "type": "stat", "x": 40, "y": 260, "width": 420, "height": 200, "label": "1% low", "metric": "fps.low1", "fontSize": 64 },

    { "type": "lines", "x": 500, "y": 20, "width": 620, "height": 220, "fontSize": 22,
      "lines": [
        { "label": "Frame time", "metric": "fps.frametime", "color": "accent" },
        { "label": "Slowest", "metric": "fps.frametime.max", "color": "warning" }
      ] },
    { "type": "stat", "x": 500, "y": 260, "width": 300, "height": 200, "label": "CPU", "metric": "cpu.load", "fontSize": 56 },
    { "type": "stat", "x": 820, "y": 260, "width": 300, "height": 200, "label": "GPU", "metric": "gpu.load", "fontSize": 56 },

    { "type": "gauge", "x": 1160, "y": 20, "width": 350, "height": 230, "label": "CPU °C", "metric": "cpu.temp", "text": "{cpu.temp:nounit}",
      "max": 100, "thresholds": [{ "above": 80, "color": "warning" }, { "above": 90, "color": "critical" }] },
    { "type": "gauge", "x": 1540, "y": 20, "width": 350, "height": 230, "label": "GPU °C", "metric": "gpu.temp", "text": "{gpu.temp:nounit}",
      "max": 100, "thresholds": [{ "above": 80, "color": "warning" }, { "above": 88, "color": "critical" }] },
    { "type": "text", "x": 1160, "y": 300, "width": 730, "height": 50, "fontSize": 30, "color": "secondary", "text": "{session.playing}: {session.game}",
      "hideUnavailable": true },
    { "type": "text", "x": 1160, "y": 350, "width": 730, "height": 110, "fontSize": 44,
      "text": "{session.minutes} min · {session.fps.avg} average", "hideUnavailable": true }
  ]
}
