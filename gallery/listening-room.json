// Listening room: what's playing with its album art, bars that move with the music right across the bottom, the time,
// and volume buttons. Works with Spotify, a browser, Media Player or any app in Windows' media controls.
{
  "width": 1920,
  "height": 480,
  "theme": "Vaporwave",
  "widgets": [
    { "type": "media", "x": 40, "y": 30, "width": 1100, "height": 240, "fontSize": 46, "controlSize": 52, "hideIdle": false },
    { "type": "clock", "x": 1200, "y": 20, "width": 680, "height": 160, "timeSize": 110, "dateSize": 24, "align": "right" },
    { "type": "buttons", "x": 1480, "y": 190, "width": 400, "height": 80, "style": "plain", "iconSize": 40, "spacing": 30,
      "buttons": [
        { "label": "", "icon": "volume-down", "action": "volume-down" },
        { "label": "", "icon": "mute", "action": "mute" },
        { "label": "", "icon": "volume-up", "action": "volume-up" }
      ] },
    { "type": "visualizer", "x": 40, "y": 300, "width": 1840, "height": 160, "bands": 64, "gap": 6, "cornerRadius": 3 }
  ]
}
